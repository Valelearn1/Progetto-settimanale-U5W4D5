# Copiare questo file in .env.local e inserire i valori reali.
# .env.local non viene versionato (vedi .gitignore).

# Indirizzo del backend Spring Boot
VITE_API_URL=http://localhost:8080

# Chiave Google Maps per la mappa interattiva.
# Le chiavi Maps JS sono per forza visibili nel browser: si proteggono
# limitandole per referrer HTTP dalla console Google Cloud, non
# nascondendole. Serve solo la "Maps JavaScript API" abilitata.
VITE_GOOGLE_MAPS_API_KEY=
