# Copiare questo file in .env, inserire i valori reali e caricarlo
# nell'ambiente prima di avviare il backend.
# .env NON viene versionato (vedi .gitignore).
#
# Da terminale:      export $(grep -v '^#' .env | xargs) && ./mvnw spring-boot:run
# Da IntelliJ:       Run > Edit Configurations > Environment variables

# --- Database PostgreSQL (obbligatorio) ---
DB_URL=jdbc:postgresql://localhost:5432/Progetto-settimanale-U5W4D5
DB_USERNAME=postgres
DB_PASSWORD=

# --- Geocoding ---
# "google" richiede la chiave qui sotto; "nominatim" funziona senza.
GEOCODING_PROVIDER=google
# Chiave della Geocoding API v4 di Google. Resta solo sul backend.
GOOGLE_MAPS_API_KEY=

# --- OCR (facoltativi: i default valgono per Homebrew su Mac) ---
# OCR_DATAPATH=/opt/homebrew/share/tessdata
# OCR_LANGUAGE=ita+eng
# OCR_NATIVE_PATH=/opt/homebrew/lib
